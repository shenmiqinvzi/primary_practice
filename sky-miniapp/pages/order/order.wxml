<view class="page">
  <view wx:for="{{orders}}" wx:key="id" class="card" bindtap="detail" data-id="{{item.id}}">
    <view>订单号：{{item.number}}</view>
    <view class="muted">{{item.orderDishes}}</view>
    <view class="price">¥{{item.amount}}</view>

    <button
      wx:if="{{item.status === 1}}"
      size="mini"
      catchtap="cancel"
      data-id="{{item.id}}"
    >
      取消订单
    </button>
    <button wx:if="{{item.status === 1}}" size="mini" class="primary" catchtap="pay" data-order="{{item}}">去支付</button>
    <button
      wx:if="{{item.status === 3}}"
      size="mini"
      bindtap="reminder"
      data-id="{{item.id}}"
    >
      催单
    </button>
  </view>

  <view wx:if="{{!orders.length}}" class="empty">暂无订单</view>
</view>
