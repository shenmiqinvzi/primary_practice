<view class="page" wx:if="{{setmeal}}">
  <image wx:if="{{setmeal.image}}" class="hero" src="{{setmeal.image}}" mode="aspectFill" />
  <view class="card">
    <view class="title">{{setmeal.name}}</view>
    <view class="price">¥{{setmeal.price}}</view>
    <view class="muted">{{setmeal.description || '精选套餐'}}</view>
  </view>
  <view class="card">
    <view class="section-title">套餐内容</view>
    <view wx:for="{{dishes}}" wx:key="dishId" class="dish-row">
      <text>{{item.name}} × {{item.copies}}</text><text>¥{{item.price}}</text>
    </view>
  </view>
  <button class="primary" bindtap="addCart">加入购物车</button>
</view>
