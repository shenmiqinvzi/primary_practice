<view class="page" wx:if="{{order}}">
  <view class="card"><view class="title">订单号：{{order.number}}</view><view>状态：{{order.status}}</view><view>收货人：{{order.consignee}} {{order.phone}}</view><view>地址：{{order.address}}</view><view>备注：{{order.remark || '无'}}</view></view>
  <view class="card"><view wx:for="{{order.orderDetailList}}" wx:key="id" class="row"><text>{{item.name}} × {{item.number}}</text><text>¥{{item.amount}}</text></view><view class="amount">合计：¥{{order.amount}}</view></view>
  <button wx:if="{{order.status === 1}}" class="primary" bindtap="cancel">取消订单</button>
  <button wx:if="{{order.status === 3}}" bindtap="reminder">催单</button>
</view>
