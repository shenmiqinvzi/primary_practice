.address-card{min-height:100rpx}.address-head{font-size:32rpx;font-weight:bold;margin-bottom:12rpx}.empty{color:#909399}.row{display:flex;justify-content:space-between;padding:18rpx 0;border-bottom:1px solid #f0f0f0}textarea{width:100%;margin-top:24rpx;background:#f7f7f7;padding:16rpx;box-sizing:border-box}.submit-bar{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:20rpx 24rpx;display:flex;justify-content:space-between;align-items:center}.submit-bar button{margin:0}
